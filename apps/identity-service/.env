# ─── identity-service .env ───────────────────────────────────────────────────
# Scoped to ONLY what identity-service needs. §5 of spec.
# Never add keys from other services here.

# Shared infra
REDIS_URL=redis://localhost:6379
NODE_ENV=development
SENTRY_DSN=

# Postgres — identity schema only
DATABASE_URL=postgresql://tridopai:tridopai@localhost:5432/tridopai?schema=identity

# MongoDB — identity_db only
MONGODB_URI=mongodb://localhost:27017/identity_db

# JWT (HS256 — Q2 decision: shared secret; see baseClient note for upgrade path to RS256)
JWT_ACCESS_SECRET=change-me-in-production-access-secret
JWT_REFRESH_SECRET=change-me-in-production-refresh-secret

# OAuth providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Health endpoint port (internal only — not internet-facing)
HEALTH_PORT=3001

# OpenTelemetry export target (§10)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
