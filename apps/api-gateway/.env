# ─── api-gateway .env ────────────────────────────────────────────────────────
# Scoped to ONLY what api-gateway needs. §5 of spec.

# Shared infra
NODE_ENV=development
SENTRY_DSN=

# HTTP
PORT=4000
ALLOWED_ORIGIN=http://localhost:3000

# JWT — shared secret for LOCAL verification only (HS256, Q2 decision).
# api-gateway uses this to verify tokens without calling identity-service per request.
JWT_ACCESS_SECRET=change-me-in-production-access-secret

# OpenTelemetry
