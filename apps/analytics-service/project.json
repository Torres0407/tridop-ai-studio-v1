{
  "name": "analytics-service",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/analytics-service/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "@nx/webpack:webpack",
      "outputs": ["{options.outputPath}"],
      "options": {
        "webpackConfig": "webpack.config.js",
        "target": "node",
        "compiler": "tsc",
        "outputPath": "dist/apps/analytics-service",
        "main": "apps/analytics-service/src/main.ts",
        "tsConfig": "apps/analytics-service/tsconfig.app.json",
        "assets": []
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --project apps/analytics-service/tsconfig.app.json --noEmit"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": [
          "apps/analytics-service/**/*.ts"
        ]
      }
    }
  },
  "tags": [
    "type:service"
  ]
}
