{
  "name": "sites-service",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/sites-service/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "options": {
        "outputPath": "dist/apps/sites-service",
        "main": "apps/sites-service/src/main.ts",
        "tsConfig": "apps/sites-service/tsconfig.app.json",
        "assets": []
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --project apps/sites-service/tsconfig.app.json --noEmit"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": [
          "apps/sites-service/**/*.ts"
        ]
      }
    }
  },
  "tags": [
    "type:service"
  ]
}
